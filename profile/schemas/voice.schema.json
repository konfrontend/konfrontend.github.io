{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "voice.md frontmatter. Every Letter-facing personal string: greeting per route and sign-off. No body: the Answers in answers/ calibrate the voice (x-body).",
  "type": "object",
  "required": ["language", "greeting", "sign_off"],
  "additionalProperties": false,
  "x-body": "empty",
  "properties": {
    "language": { "enum": ["en-US", "en-GB"], "default": "en-US" },
    "greeting": {
      "type": "object",
      "required": ["freelance", "employment"],
      "additionalProperties": false,
      "properties": {
        "freelance": { "type": "string", "minLength": 1, "default": "Hi," },
        "employment": { "type": "string", "minLength": 1, "default": "Hello," }
      }
    },
    "sign_off": { "type": "string", "minLength": 1 },
    "banned_extra": { "type": "array", "items": { "type": "string" }, "default": [] },
    "allowed_extra": { "type": "array", "items": { "type": "string" }, "default": [] }
  }
}
