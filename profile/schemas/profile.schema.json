{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "profile.md frontmatter: the person's identity, contact, resume order and terms. Skills are never declared here; they derive from the Projects' keywords.",
  "type": "object",
  "required": ["identity", "contact", "resume_order", "terms"],
  "additionalProperties": false,
  "properties": {
    "identity": {
      "type": "object",
      "required": ["name", "timezone", "constraints"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "location": { "type": "string" },
        "timezone": { "type": "string", "pattern": "^[A-Za-z]+(/[A-Za-z_+-]+)+$|^UTC$" },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "contact": {
      "type": "object",
      "required": ["location", "email"],
      "additionalProperties": false,
      "properties": {
        "location": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" },
        "github": { "type": "string", "pattern": "^https://github\\.com/" },
        "linkedin": { "type": "string", "pattern": "^https://www\\.linkedin\\.com/in/" }
      }
    },
    "resume_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "terms": {
      "type": "object",
      "required": ["rate", "rate_floor"],
      "additionalProperties": false,
      "properties": {
        "rate": { "type": "number", "minimum": 1 },
        "rate_floor": { "type": "number", "minimum": 1 },
        "salary_floor": {
          "type": "object",
          "required": ["type", "amount", "currency"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["annual", "monthly", "hourly"] },
            "amount": { "type": "number", "minimum": 1 },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
          }
        },
        "weekly_hours": { "type": "object", "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } } },
        "availability_from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$|^now$" },
        "local_hours": { "type": "string" },
        "ip_stance": { "enum": ["assigned-on-payment", "licensed"], "default": "assigned-on-payment" }
      }
    }
  }
}
