{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A Version: a selection over the Profile. `projects` maps a Project slug to the Story keys it shows; `skills` are the hand-grouped Skills lines, every term a canonical Skill; `summary` is the paragraph after the contact line.",
  "type": "object",
  "required": ["title", "summary", "skills", "projects"],
  "additionalProperties": false,
  "x-body": "empty",
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "skills": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[^:]+: .+$" } },
    "projects": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "uniqueItems": true }
    }
  }
}
