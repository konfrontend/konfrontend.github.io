{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "data/profile/skills.md frontmatter: the Skill ledger (catalogue/skills.md, GEM-337). A summary: one row per Skill with its Level, category, aliases, roles and Seen count. Evidence is never stored; it derives from the Projects' keywords. Targets derive from level and seen.",
  "type": "object",
  "required": ["target_after", "categories", "skills"],
  "additionalProperties": false,
  "properties": {
    "target_after": { "type": "integer", "minimum": 1, "default": 3 },
    "categories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "contains": { "properties": { "level": { "const": "shipped" } }, "required": ["level"] },
      "items": {
        "type": "object",
        "required": ["name", "category", "level", "keywords", "roles", "seen"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "level": { "enum": ["gap", "learning", "used", "shipped"] },
          "keywords": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "^[^A-Z\\s][^A-Z]*$" }, "uniqueItems": true },
          "roles": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "uniqueItems": true },
          "seen": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
