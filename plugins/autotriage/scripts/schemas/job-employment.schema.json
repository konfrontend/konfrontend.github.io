{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "job.md frontmatter, employment route (catalogue/candidate-artifacts.md)",
  "type": "object",
  "required": ["slug", "title", "date", "route", "company", "employment", "remote", "timezone"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "route": { "const": "employment" },
    "company": { "type": ["string", "null"], "minLength": 1 },
    "employment": { "enum": ["full-time", "part-time", "contract"] },
    "remote": { "enum": ["remote", "hybrid", "on-site"] },
    "location": { "type": "string", "minLength": 1 },
    "timezone": { "type": "string", "pattern": "^[A-Za-z]+(/[A-Za-z_+-]+)+$|^UTC$" },
    "salary": {
      "type": "object",
      "required": ["type", "currency"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["annual", "monthly", "hourly"] },
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      },
      "anyOf": [{ "required": ["min"] }, { "required": ["max"] }]
    },
    "source": { "type": "string", "minLength": 1 },
    "extras": { "type": "object" },
    "recorded_skills": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "requirements": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "verdict": {
      "type": "object",
      "required": ["flags", "skill_fit", "interest_fit", "value", "alert_level", "hard_stops", "verdict", "decision"],
      "additionalProperties": false,
      "properties": {
        "flags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true },
        "skill_fit": { "type": "integer", "minimum": 1, "maximum": 5 },
        "interest_fit": { "type": "integer", "minimum": 1, "maximum": 5 },
        "value": { "type": "integer", "minimum": 1, "maximum": 5 },
        "alert_level": { "type": "integer", "minimum": 1, "maximum": 5 },
        "hard_stops": { "type": "array", "items": { "enum": ["alert-level-5", "level-5-flag", "refused-stack", "unmet-constraint"] } },
        "verdict": { "enum": ["go", "no-go", "ask"] },
        "decision": { "enum": ["go", "no-go", null] }
      }
    }
  }
}
