{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cover-letter.md frontmatter (catalogue/candidate-artifacts.md)",
  "type": "object",
  "required": ["slug", "date", "outcome"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "outcome": { "enum": ["ignored", "rejected", "interviewed", "hired", null] }
  }
}
